# 镜像 tag（仅 deployments/docker/docker-compose.yml 用；留空 = latest）。
# 生产建议锁不可变 tag（语义化版本或构建短 sha），别长期跟 latest。
COCKPIT_IMAGE_TAG=
COCKPIT_HTTP_PORT=9000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
TOTP_ENCRYPTION_KEY=replace-with-a-32-byte-random-key
PRODUCTION=true
ALLOWED_ORIGINS=http://localhost:9000
TZ=Asia/Shanghai
# 远控栈（guacd）：--profile guacd 启用时设 guacd:4822（同网络 DNS 名，
# 不能写 127.0.0.1——那是 guacd 容器自己的回环）。留空 = 前端隐藏 RDP/VNC/SSH 入口。
GUACD_ADDR=
# guacd 录制目录：须与 guacd 容器挂载点同卷同路径，否则 .guac 归档收不到
GUACD_RECORDING_PATH=/var/lib/guacamole
# 别开 debug：会打印 connect 指令参数（含口令/私钥）
GUACD_LOG_LEVEL=info
