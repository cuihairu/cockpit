# Cockpit Server environment
# Copy to /etc/default/cockpit-server and edit before starting the service.

# Required: initial/admin password. The server refuses to start without it.
ADMIN_PASSWORD=change-this-password

# Optional: admin username. Defaults to admin.
ADMIN_USERNAME=admin

# Recommended in production.
# PRODUCTION=true
# TOTP_ENCRYPTION_KEY=replace-with-a-strong-random-key
# ALLOWED_ORIGINS=https://cockpit.example.com
