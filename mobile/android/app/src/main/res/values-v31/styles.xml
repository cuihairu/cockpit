<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+（API 31+）SplashScreen API 主题。
  系统启动窗口统一由 windowSplashScreenBackground/AnimatedIcon 控制，
  不再依赖 launch_background layer-list（其仍作旧版本回退）。
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ 启动窗口 -->
        <item name="android:windowSplashScreenBackground">#1E88E5</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_background</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
