<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- debug 构建放行 cleartext（本地 http server 调试），见 res/xml/network_security_config.xml。
         main manifest 是 usesCleartextTraffic="false"，debug 需 tools:replace 覆盖，
         否则 Manifest merger 报冲突（c0e6b846 引入的真 bug，CI Android APK 挂）。 -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
