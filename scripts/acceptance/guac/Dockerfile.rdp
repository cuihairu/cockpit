# 远控三协议真机验收：RDP 目标容器（xrdp + xorgxrdp，会话内容=xterm）
# 尽力而为项：xrdp 在无 systemd 容器内以 nodaemon 方式跑，会话管理器
# startwm.sh 替换为直接 exec xterm（无桌面环境依赖）。
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        xrdp xorgxrdp xterm fonts-dejavu-core openssl && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash accept && \
    echo 'accept:Accept-Guac-2026' | chpasswd

# RDP TLS 证书（容器内 postinst 不生成，自行签发自签证书）
RUN mkdir -p /etc/xrdp && \
    openssl req -x509 -newkey rsa:2048 -nodes -days 30 \
        -keyout /etc/xrdp/key.pem -out /etc/xrdp/cert.pem -subj /CN=guac-accept-rdp && \
    chmod 600 /etc/xrdp/key.pem

# 会话内容：登录后直接进 xterm（guacd ignore-cert=true 对自签证书免疫）
RUN printf '#!/bin/sh\nexec xterm\n' > /etc/xrdp/startwm.sh && chmod +x /etc/xrdp/startwm.sh

COPY start-rdp.sh /start-rdp.sh
RUN chmod +x /start-rdp.sh

EXPOSE 3389
CMD ["/start-rdp.sh"]
