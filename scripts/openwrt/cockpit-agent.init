#!/bin/sh /etc/rc.common
# cockpit-agent procd 服务：从 UCI (/etc/config/cockpit-agent) 读参启动。
# 字段与 `cockpit-agent start` flags 一一映射，UCI 为唯一配置真源。

USE_PROCD=1
START=99
STOP=15

PROG=/usr/bin/cockpit-agent

start_service() {
    config_load cockpit-agent

    config_get server main server ''
    config_get secret main secret ''
    config_get agent_id main id ''
    config_get region main region ''
    config_get zone main zone ''
    config_get labels main labels ''

    if [ -z "$server" ]; then
        echo "cockpit-agent: uci cockpit-agent.main.server 未配置，跳过启动" >&2
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" start -server "$server"
    [ -n "$secret" ] && procd_append_param command -secret "$secret"
    [ -n "$agent_id" ] && procd_append_param command -id "$agent_id"
    [ -n "$region" ] && procd_append_param command -region "$region"
    [ -n "$zone" ] && procd_append_param command -zone "$zone"
    [ -n "$labels" ] && procd_append_param command -labels "$labels"

    # 崩溃自动拉起（procd 默认策略：3600s 内重启超 5 次退避）
    procd_set_param respawn
    # stdout/stderr 进 logd：logread | grep cockpit-agent
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}
